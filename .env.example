# Every variable here is optional — the panel runs with none of them set.
# Copy to `.env` and edit. See the README for the full table.

# Base URL that useApi() sends requests to.
NUXT_PUBLIC_API_URL=http://localhost:4000

# Demo mode lets godpanel@test.com / god123 sign in with no backend.
# Set to false once your API is wired up — leaving it true in production
# means anyone can sign in with the demo account.
NUXT_PUBLIC_DEMO_MODE=true

# Canonical site URL (optional).
# NUXT_PUBLIC_SITE_URL=https://panel.example.com

# When set, plugins/error-handler.client.ts forwards errors to your reporter.
# NUXT_PUBLIC_SENTRY_DSN=

# Overrides the god-kit docs link in the sidebar and settings page.
# NUXT_PUBLIC_GOD_KIT_DOCS=https://godkit.godplans.org/
